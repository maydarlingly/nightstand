# Файлы из этого списка git не отправляет на GitHub.

# Служебные файлы macOS (Finder создаёт их сам)
.DS_Store
._*

# Секреты: ключи, пароли, токены
.env
.env.*
*.key
*.pem

# Настройки редакторов и Claude Code
.vscode/
.idea/
.claude/

# Зависимости и сборка (если появится npm)
node_modules/
dist/

# Логи и временные файлы
*.log
*.tmp
